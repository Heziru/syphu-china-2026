.cosmic-journey {
  position: relative;
  height: 520vh;
  background: #02040b;
  color: #eef2ef;
}
.cosmic-journey--reduced {
  height: 115vh;
}
.cosmic-journey__sticky {
  position: sticky;
  top: 0;
  height: 100dvh;
  overflow: hidden;
  background: #02040b;
}
.cosmic-journey__sticky canvas {
  position: absolute !important;
  inset: 0;
  width: 100% !important;
  height: 100% !important;
}
.cosmic-journey__vignette {
  position: absolute;
  inset: 0;
  pointer-events: none;
  background:
    radial-gradient(
      circle at 58% 46%,
      transparent 20%,
      rgba(2, 4, 11, 0.14) 54%,
      rgba(2, 4, 11, 0.82) 100%
    ),
    linear-gradient(90deg, rgba(2, 4, 11, 0.65), transparent 46%);
}
.cosmic-journey__copy {
  position: absolute;
  z-index: 2;
  left: clamp(1.4rem, 7vw, 8.5rem);
  top: 50%;
  width: min(35rem, 74vw);
  transform: translateY(-50%);
  animation: cosmic-copy-in 0.72s cubic-bezier(0.2, 0.75, 0.25, 1) both;
}
.cosmic-journey__copy p {
  margin: 0 0 0.8rem;
  color: #86adae;
  font:
    600 0.68rem/1.2 ui-monospace,
    SFMono-Regular,
    Consolas,
    monospace;
  letter-spacing: 0.22em;
}
.cosmic-journey__copy h1 {
  margin: 0;
  max-width: 13ch;
  color: #f0eee8;
  font:
    400 clamp(2.5rem, 6.5vw, 6.8rem)/0.94 Georgia,
    "Times New Roman",
    serif;
  letter-spacing: -0.045em;
  text-wrap: balance;
}
.cosmic-journey__copy span {
  display: block;
  margin-top: 1.15rem;
  max-width: 29rem;
  color: rgba(220, 229, 228, 0.7);
  font-size: clamp(0.88rem, 1.15vw, 1.05rem);
  letter-spacing: 0.025em;
  line-height: 1.55;
}
.cosmic-journey__identity {
  position: absolute;
  z-index: 2;
  right: clamp(1.25rem, 4vw, 4.5rem);
  bottom: clamp(4.4rem, 9vh, 7rem);
  display: flex;
  align-items: center;
  gap: 0.8rem;
  color: rgba(220, 229, 228, 0.72);
  font:
    600 0.64rem/1.2 ui-monospace,
    monospace;
  letter-spacing: 0.15em;
  animation: cosmic-copy-in 0.8s ease both;
}
.cosmic-journey__identity img {
  width: 3.25rem;
  height: 3.25rem;
  border-radius: 50%;
  object-fit: contain;
  background: #fff;
  box-shadow:
    0 0 0 1px rgba(227, 202, 144, 0.45),
    0 0 30px rgba(146, 47, 50, 0.22);
}
.cosmic-journey__rail {
  position: absolute;
  z-index: 2;
  right: clamp(1rem, 2.2vw, 2.25rem);
  top: 50%;
  display: grid;
  gap: 0.58rem;
  transform: translateY(-50%);
}
.cosmic-journey__rail i {
  display: block;
  width: 1px;
  height: 1.75rem;
  background: rgba(255, 255, 255, 0.15);
  transition:
    background 0.5s,
    height 0.5s;
}
.cosmic-journey__rail i.is-active {
  height: 2.4rem;
  background: #82acab;
}
.cosmic-journey__scroll {
  position: absolute;
  z-index: 2;
  left: clamp(1.4rem, 7vw, 8.5rem);
  bottom: 1.5rem;
  display: flex;
  align-items: center;
  gap: 0.65rem;
  color: rgba(220, 229, 228, 0.48);
  font:
    500 0.62rem/1 ui-monospace,
    monospace;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}
.cosmic-journey__scroll span {
  display: block;
  width: 2.8rem;
  height: 1px;
  background: currentColor;
  transform-origin: left;
  animation: cosmic-line 2s ease-in-out infinite;
}
@keyframes cosmic-copy-in {
  from {
    opacity: 0;
    transform: translateY(calc(-50% + 18px));
    filter: blur(5px);
  }
  to {
    opacity: 1;
    transform: translateY(-50%);
    filter: blur(0);
  }
}
@keyframes cosmic-line {
  0%,
  100% {
    transform: scaleX(0.2);
    opacity: 0.35;
  }
  50% {
    transform: scaleX(1);
    opacity: 1;
  }
}
@media (max-width: 700px) {
  .cosmic-journey {
    height: 450vh;
  }
  .cosmic-journey__copy {
    top: 31%;
    left: 1.25rem;
    width: calc(100% - 3.4rem);
  }
  .cosmic-journey__copy h1 {
    font-size: clamp(2.15rem, 11vw, 4.1rem);
  }
  .cosmic-journey__identity {
    right: 1.1rem;
    bottom: 4rem;
  }
  .cosmic-journey__rail {
    right: 0.75rem;
  }
  .cosmic-journey__scroll {
    left: 1.25rem;
  }
}
@media (prefers-reduced-motion: reduce) {
  .cosmic-journey__copy,
  .cosmic-journey__identity {
    animation: none;
  }
  .cosmic-journey__scroll span {
    animation: none;
    transform: scaleX(1);
  }
}

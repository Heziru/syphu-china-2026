/* LBP-Mototype Home — five-scene exhibition (mototype- / moto- / home-hero) */

.mototype-home,
.home {
  --moto-ink: #1a2421;
  --moto-cream: #f3efe6;
  --moto-paper: #f7f3eb;
  --moto-deep: #0e1715;
  --moto-emerald: #2e8b57;
  --moto-teal: #1a8f8a;
  --moto-muted: #5d6e68;
  --moto-ros: #a85a42;
  --moto-font: "Candara", "Segoe UI", "PingFang SC", "Microsoft YaHei", sans-serif;
  --moto-display: "Bahnschrift", "Candara", "Segoe UI", "PingFang SC", sans-serif;

  --home-lime: #7ecf4a;
  --home-emerald: var(--moto-emerald);
  --home-teal: var(--moto-teal);
  --home-deep: var(--moto-deep);
  --home-ink: var(--moto-ink);
  --home-cream: var(--moto-cream);
  --home-mist: #ebe4d7;
  --home-muted: #9bb5ad;
  --home-text: #e7f3ec;
  --home-text-dark: var(--moto-ink);
  --home-font: var(--moto-font);
  --home-display: var(--moto-display);

  color: var(--moto-ink);
  font-family: var(--moto-font);
  background: var(--moto-cream);
  overflow-x: clip;
}

.home-sr-only {
  position: absolute;
  width: 1px;
  height: 1px;
  padding: 0;
  margin: -1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  border: 0;
}

/* —— Hero (logo glass shards) —— */
.home-hero {
  position: relative;
  min-height: calc(100vh - 56px);
  min-height: calc(100dvh - 56px);
  background: #121c1a;
  user-select: none;
  -webkit-user-select: none;
  color: var(--home-text);
  overflow: hidden;
}

.logo-assembly {
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
}

.logo-shards-canvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;
  pointer-events: none;
}

/* Fallback only when cropped canvas source fails to load */
.logo-assembly__fallback {
  position: absolute;
  inset: 0;
  margin: auto;
  width: min(52vw, 72vh, 760px);
  height: auto;
  aspect-ratio: 971 / 735;
  object-fit: cover;
  object-position: top center;
  pointer-events: none;
}

@media (max-width: 899px) {
  .logo-assembly__fallback {
    width: min(84vw, 58vh, 520px);
  }
}

.home-hero__chrome {
  position: absolute;
  left: 50%;
  bottom: clamp(1.5rem, 7vh, 3.5rem);
  z-index: 3;
  transform: translateX(-50%);
  width: min(94vw, 1200px);
  text-align: center;
  pointer-events: none;
}

.mototype-hero-title {
  width: min(94vw, 1200px);
  margin: 0 auto;
  text-align: center;
  white-space: nowrap;
  font-family: var(--moto-display);
  font-size: clamp(2.8rem, 8vw, 7.8rem);
  line-height: 0.92;
  letter-spacing: -0.055em;
  font-weight: 700;
  color: #f4faf6;
  text-shadow:
    0 1px 2px rgba(8, 16, 14, 0.55),
    0 8px 28px rgba(8, 16, 14, 0.35);
}

.home-hero__hint {
  margin: 0.95rem 0 0;
  font-size: clamp(0.95rem, 1.4vw, 1.1rem);
  letter-spacing: 0.02em;
  color: rgba(201, 230, 216, 0.72);
  text-shadow: 0 1px 10px rgba(8, 16, 14, 0.45);
  transition: color 0.3s ease;
}

.home-hero--assembling .home-hero__hint {
  color: rgba(126, 207, 74, 0.9);
}

/* —— Gesture camera dock (bottom-left) —— */
.gesture-dock {
  position: absolute;
  left: clamp(12px, 2vw, 28px);
  bottom: calc(clamp(12px, 2vw, 28px) + env(safe-area-inset-bottom, 0px));
  z-index: 6;
  pointer-events: auto;
  max-width: min(260px, calc(100vw - 24px));
  transition: opacity 0.65s ease, transform 0.65s ease;
}

.gesture-dock--fade {
  opacity: 0;
  transform: translateY(6px);
  pointer-events: none;
}

.gesture-preview {
  position: relative;
  width: clamp(190px, 15vw, 240px);
  aspect-ratio: 4 / 3;
  max-width: 260px;
  max-height: 195px;
  border-radius: 12px;
  border: 1px solid rgba(126, 207, 74, 0.28);
  background: #1a2220;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.28);
  overflow: hidden;
}

.gesture-preview--placeholder,
.gesture-preview--error {
  background: #161d1b;
}

.gesture-preview__mirror {
  position: absolute;
  inset: 0;
  transform: scaleX(-1);
  transform-origin: center;
}

.gesture-preview__video,
.gesture-landmarks {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;
  object-fit: cover;
  border: 0;
}

.gesture-landmarks {
  pointer-events: none;
}

.gesture-preview__placeholder {
  position: absolute;
  inset: 0;
  z-index: 2;
  display: flex;
  flex-direction: column;
  justify-content: center;
  align-items: flex-start;
  gap: 0.35rem;
  padding: 0.85rem 0.9rem;
  box-sizing: border-box;
}

.gesture-preview__eyebrow {
  font-size: 0.62rem;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  color: rgba(168, 220, 192, 0.55);
}

.gesture-preview__body {
  font-size: 0.78rem;
  line-height: 1.35;
  color: rgba(236, 246, 240, 0.9);
}

.gesture-preview__privacy {
  margin-top: 0.35rem;
  font-size: 0.72rem;
  line-height: 1.35;
  color: rgba(180, 205, 192, 0.62);
}

.gesture-preview__unavailable {
  font-size: 0.72rem;
  line-height: 1.35;
  color: rgba(200, 180, 160, 0.85);
}

.gesture-retry {
  margin-top: 0.35rem;
  height: 30px;
  padding: 0 0.65rem;
  border: 1px solid rgba(168, 220, 192, 0.35);
  border-radius: 8px;
  background: transparent;
  color: rgba(232, 244, 236, 0.92);
  font-size: 0.72rem;
  cursor: pointer;
}

.gesture-retry:hover {
  border-color: rgba(126, 207, 74, 0.55);
}

.gesture-retry:focus-visible {
  outline: 2px solid rgba(126, 207, 74, 0.55);
  outline-offset: 1px;
}

.gesture-preview-status {
  position: absolute;
  left: 8px;
  right: 32px;
  bottom: 8px;
  z-index: 2;
  margin: 0;
  padding: 0.15rem 0.35rem;
  border-radius: 6px;
  font-size: 0.68rem;
  line-height: 1.3;
  letter-spacing: 0.04em;
  text-transform: uppercase;
  color: rgba(236, 246, 240, 0.9);
  background: rgba(10, 16, 14, 0.55);
  pointer-events: none;
}

.gesture-preview__progress {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 3;
  height: 2px;
  background: rgba(255, 255, 255, 0.08);
  pointer-events: none;
}

.gesture-preview__progress::after {
  content: "";
  display: block;
  height: 100%;
  width: calc(var(--gesture-progress, 0) * 100%);
  background: rgba(126, 207, 74, 0.85);
  transition: width 0.08s linear;
}

.gesture-close {
  position: absolute;
  top: 4px;
  right: 4px;
  z-index: 4;
  width: 26px;
  height: 26px;
  border: 0;
  border-radius: 8px;
  background: rgba(10, 16, 14, 0.55);
  color: rgba(236, 246, 240, 0.9);
  font-size: 1rem;
  line-height: 1;
  cursor: pointer;
}

.gesture-close:hover {
  background: rgba(10, 16, 14, 0.75);
}

.gesture-close:focus-visible {
  outline: 2px solid rgba(126, 207, 74, 0.55);
  outline-offset: 1px;
}

.gesture-tap-start {
  position: absolute;
  left: 50%;
  top: 50%;
  z-index: 5;
  transform: translate(-50%, -50%);
  min-height: 40px;
  padding: 0.55rem 0.95rem;
  border: 1px solid rgba(168, 220, 192, 0.45);
  border-radius: 9px;
  background: rgba(14, 23, 21, 0.88);
  color: rgba(236, 246, 240, 0.95);
  font-size: 0.78rem;
  line-height: 1.25;
  cursor: pointer;
  white-space: normal;
  max-width: calc(100% - 16px);
  text-align: center;
  -webkit-tap-highlight-color: transparent;
  touch-action: manipulation;
}

.gesture-tap-start:active {
  border-color: rgba(126, 207, 74, 0.7);
}

@media (max-width: 640px) {
  .gesture-preview {
    width: clamp(126px, 34vw, 154px);
  }
}

.mototype-persistence-copy {
  position: absolute;
  left: clamp(2rem, 7vw, 8rem);
  top: 50%;
  z-index: 4;
  width: min(30vw, 430px);
  transform: translateY(-50%);
  margin: 0;
  font-size: clamp(1rem, 1.25vw, 1.3rem);
  line-height: 1.65;
  letter-spacing: 0.01em;
  font-weight: 400;
  text-align: left;
  color: rgba(245, 244, 236, 0.82);
  white-space: pre-line;
  pointer-events: none;
  text-shadow: 0 1px 12px rgba(8, 16, 14, 0.35);
}

.mototype-persistence-copy.is-fading {
  opacity: 0;
  transform: translateY(calc(-50% - 12px));
  transition:
    opacity 950ms ease,
    transform 950ms ease;
}

.mototype-persistence-caret {
  display: inline-block;
  margin-left: 1px;
  opacity: 0.45;
  animation: moto-caret 800ms steps(1) infinite;
}

@keyframes moto-caret {
  50% {
    opacity: 0;
  }
}

@media (max-width: 900px) {
  .home-hero__chrome {
    bottom: 14%;
  }

  .mototype-persistence-copy {
    left: 50%;
    top: auto;
    bottom: 5.5%;
    width: 82vw;
    transform: translateX(-50%);
    text-align: center;
    font-size: clamp(0.95rem, 3.4vw, 1.05rem);
  }

  .mototype-persistence-copy.is-fading {
    transform: translate(-50%, -10px);
  }
}

@media (max-width: 390px) {
  .mototype-hero-title {
    font-size: clamp(2.45rem, 12vw, 3.4rem);
    letter-spacing: -0.06em;
  }
}

/* —— Scene runway —— */
.moto-scene {
  position: relative;
  background-color: var(--moto-cream);
}

.moto-scene--cream {
  background-color: var(--moto-cream);
  color: var(--moto-ink);
}

.moto-scene--paper {
  background-color: var(--moto-paper);
  color: var(--moto-ink);
}

.moto-scene--ink {
  background-color: var(--moto-deep);
  color: #e7f3ec;
}

.moto-scene--pin {
  height: calc(100vh * (1 + var(--moto-travel, 1.35)));
  height: calc(100dvh * (1 + var(--moto-travel, 1.35)));
}

.moto-scene--pin .moto-scene__stage {
  position: sticky;
  top: 56px;
  height: calc(100vh - 56px);
  height: calc(100dvh - 56px);
  display: grid;
  align-items: center;
  overflow: hidden;
  will-change: opacity;
}

.moto-scene--static .moto-scene__stage {
  min-height: calc(100vh - 56px);
  min-height: calc(100dvh - 56px);
  display: grid;
  align-items: center;
  padding-block: clamp(3rem, 8vh, 5rem);
}

.moto-scene-title {
  margin: 0 0 0.75rem;
  max-width: 14ch;
  font-family: var(--moto-display);
  font-size: clamp(2.4rem, 5vw, 4.2rem);
  font-weight: 650;
  line-height: 1.05;
  letter-spacing: -0.02em;
  color: var(--moto-ink);
  text-wrap: balance;
}

.moto-scene-title--on-ink {
  color: #f3faf6;
}

.moto-scene-sub {
  margin: 0;
  max-width: 28ch;
  font-size: clamp(1.05rem, 1.4vw, 1.25rem);
  line-height: 1.45;
  color: var(--moto-muted);
}

.moto-scene--ink .moto-scene-sub {
  color: #9bb5ad;
}

/* Challenge */
.moto-challenge {
  width: min(1120px, calc(100% - 2.5rem));
  margin-inline: auto;
  display: grid;
  grid-template-columns: 1.1fr 0.9fr;
  gap: clamp(1.5rem, 4vw, 3.5rem);
  align-items: center;
}

.moto-challenge__svg {
  display: block;
  width: 100%;
  height: auto;
  border: 1px solid rgba(36, 48, 44, 0.12);
}

.moto-challenge__word {
  margin: 1.5rem 0 0;
  font-family: var(--moto-display);
  font-size: clamp(1.4rem, 3vw, 2rem);
  letter-spacing: 0.12em;
  color: var(--moto-ros);
}

/* Living */
.moto-living {
  width: min(1120px, calc(100% - 2.5rem));
  margin-inline: auto;
  display: grid;
  grid-template-columns: 0.9fr 1.1fr;
  gap: clamp(1.5rem, 4vw, 3.5rem);
  align-items: center;
}

.moto-living__svg {
  display: block;
  width: min(100%, 320px);
  height: auto;
  margin-inline: auto;
  border: 1px solid rgba(36, 48, 44, 0.1);
  background: #f0ebe1;
}

.moto-living__verb {
  margin: 0 0 1rem;
  font-family: var(--moto-display);
  font-size: clamp(2.8rem, 7vw, 5.5rem);
  font-weight: 650;
  letter-spacing: 0.06em;
  line-height: 1;
  color: var(--moto-ink);
}

/* Mototype proto */
.moto-proto {
  width: min(1120px, calc(100% - 2.5rem));
  margin-inline: auto;
  display: grid;
  gap: 1.5rem;
  justify-items: start;
}

.moto-proto__stage {
  position: relative;
  width: 100%;
}

.moto-proto__svg {
  display: block;
  width: 100%;
  height: auto;
  border: 1px solid rgba(168, 220, 192, 0.15);
}

.moto-proto__labels {
  position: absolute;
  inset: 0;
  display: grid;
  place-items: center;
  pointer-events: none;
}

.moto-proto__label {
  position: absolute;
  top: 12%;
  right: 8%;
  font-family: var(--moto-display);
  font-size: clamp(1rem, 2vw, 1.35rem);
  letter-spacing: 0.14em;
  color: #c9e6d8;
  border-bottom: 1px solid currentColor;
}

.moto-proto__closing {
  margin: 0;
  max-width: 28ch;
  font-size: clamp(1.15rem, 2vw, 1.5rem);
  line-height: 1.4;
  color: #c9e6d8;
}

/* Explore */
.moto-explore .moto-scene__stage {
  width: min(900px, calc(100% - 2.5rem));
  margin-inline: auto;
  position: relative;
}

.moto-explore__zh {
  margin: 0 0 2rem;
  font-size: clamp(0.95rem, 1.4vw, 1.1rem);
  color: var(--moto-muted);
  max-width: 28ch;
}

.moto-explore__nav {
  display: grid;
}

.moto-explore__link {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 0.35rem 1rem;
  align-items: baseline;
  padding: 1.15rem 0;
  border-bottom: 1px solid rgba(36, 48, 44, 0.14);
  color: inherit;
  text-decoration: none;
  opacity: 0.38;
  transition:
    opacity 0.35s ease,
    transform 0.35s ease;
}

.moto-explore__link:first-child {
  border-top: 1px solid rgba(36, 48, 44, 0.14);
}

.moto-explore__link:hover,
.moto-explore__link:focus-visible,
.moto-explore__link.is-active {
  opacity: 1;
  transform: translateX(6px);
}

.moto-explore__link:focus-visible {
  outline: 2px solid var(--moto-emerald);
  outline-offset: 4px;
}

.moto-explore__label {
  font-family: var(--moto-display);
  font-size: clamp(1.8rem, 4vw, 3rem);
  line-height: 1.1;
  color: var(--moto-ink);
}

.moto-explore__blurb {
  grid-column: 1;
  font-size: 0.95rem;
  color: var(--moto-muted);
  opacity: 0;
  max-height: 0;
  overflow: hidden;
  transition:
    opacity 0.3s ease,
    max-height 0.3s ease;
}

.moto-explore__link:hover .moto-explore__blurb,
.moto-explore__link:focus-visible .moto-explore__blurb,
.moto-explore__link.is-active .moto-explore__blurb {
  opacity: 1;
  max-height: 3rem;
}

.moto-explore__arrow {
  font-size: 1.4rem;
  color: var(--moto-emerald);
}

.moto-explore__symbol {
  position: absolute;
  right: 0;
  top: 30%;
  opacity: 0;
  transform: translateX(12px);
  transition:
    opacity 0.4s ease,
    transform 0.4s ease;
  pointer-events: none;
}

.moto-explore__symbol.is-visible {
  opacity: 0.9;
  transform: none;
}

/* Logo crop */
.mototype-symbol-crop {
  position: relative;
  overflow: hidden;
  aspect-ratio: 971 / 870;
}

.mototype-symbol-crop img {
  position: absolute;
  inset: 0 auto auto 0;
  width: 100%;
  height: auto;
  display: block;
}

.mototype-symbol-crop--scene {
  width: min(46vw, 420px);
}

.mototype-symbol-crop--mark {
  width: min(28vw, 220px);
}

.mototype-symbol-crop--hero {
  width: min(46vw, 520px);
}

/* Responsive */
@media (max-width: 900px) {
  .moto-scene--pin {
    height: auto;
  }

  .moto-scene--pin .moto-scene__stage {
    position: relative;
    top: auto;
    height: auto;
    min-height: calc(100vh - 56px);
    opacity: 1 !important;
    padding-block: clamp(3rem, 8vh, 5rem);
  }

  .moto-challenge,
  .moto-living {
    grid-template-columns: 1fr;
  }

  .moto-explore__symbol {
    display: none;
  }

  .moto-explore__link {
    opacity: 1;
  }

  .moto-explore__blurb {
    opacity: 1;
    max-height: none;
  }
}

@media (prefers-reduced-motion: reduce) {
  .moto-explore__link,
  .moto-explore__blurb,
  .moto-explore__symbol {
    transition: none;
  }

  .moto-scene--pin {
    height: auto;
  }

  .moto-scene--pin .moto-scene__stage {
    position: relative;
    height: auto;
    min-height: calc(100vh - 56px);
    opacity: 1 !important;
  }
}

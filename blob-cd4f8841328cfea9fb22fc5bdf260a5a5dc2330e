.team-mentors {
  padding: 112px 6vw 70px;
  background: #e9ede3;
  scroll-margin-top: 76px;
}
.mentor-heading {
  display: flex;
  align-items: end;
  justify-content: space-between;
  gap: 6vw;
  margin-bottom: 64px;
}
.mentor-heading h2 {
  font-size: clamp(42px, 5.8vw, 90px);
  margin-top: 20px;
}
.mentor-heading > p {
  max-width: 260px;
  font-size: 14px;
  line-height: 1.8;
  padding-bottom: 8px;
}
.mentor-pi {
  display: grid;
  grid-template-columns: minmax(260px, 0.8fr) 1.35fr;
  background: #f8f5eb;
  border: 1px solid #3659541c;
  border-radius: 4px;
  overflow: hidden;
  box-shadow: 0 24px 80px #314d3c0a;
}
.mentor-pi-photo {
  position: relative;
  border: 0;
  background: #abc5c4;
  padding: 0;
  min-height: 700px;
  overflow: hidden;
  text-align: left;
}
.mentor-pi-photo .team-portrait {
  position: absolute;
  inset: 0;
  height: 100%;
  width: 100%;
  aspect-ratio: auto;
}
.mentor-pi-photo img {
  transition: transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
}
.mentor-pi-photo:hover img {
  transform: scale(1.035);
}
.mentor-pi-badge {
  position: absolute;
  left: 28px;
  top: 28px;
  padding: 10px 13px;
  background: #f8f5ebeb;
  border: 1px solid #ffffff70;
  border-radius: 2px;
  font-size: 9px;
  font-weight: 800;
  letter-spacing: 0.1em;
}
.mentor-photo-caption {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: #28463fde;
  color: #f8e7bd;
  backdrop-filter: blur(10px);
  padding: 28px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.12em;
}
.mentor-photo-caption > span {
  font-size: 24px;
  font-weight: 400;
}
.mentor-pi-main {
  padding: 40px clamp(24px, 3.5vw, 60px) 24px;
  min-width: 0;
}
.mentor-pi-intro h3 {
  font-size: clamp(38px, 4.7vw, 68px);
  font-weight: 900;
  letter-spacing: -0.065em;
  line-height: 1;
  margin: 16px 0;
}
.mentor-pi-intro h3 > span {
  font-size: 0.29em;
  letter-spacing: -0.03em;
  white-space: nowrap;
}
.mentor-pi-intro > p:last-child {
  font-size: 12px;
  line-height: 1.7;
  color: #6e8278;
}
.mentor-tabs {
  display: flex;
  gap: clamp(14px, 2.4vw, 34px);
  margin-top: 36px;
  border-bottom: 1px solid #36595425;
}
.mentor-tabs button {
  padding: 14px 0;
  border: 0;
  background: none;
  font-size: 11px;
  font-weight: 800;
  position: relative;
  white-space: nowrap;
}
.mentor-tabs button:after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: -1px;
  height: 2px;
  background: #365954;
  transform: scaleX(0);
  transform-origin: left;
  transition: transform 0.3s;
}
.mentor-tabs button[aria-selected="true"]:after {
  transform: scaleX(1);
}
.mentor-tabs button[aria-selected="false"] {
  color: #84918a;
}
.mentor-panel {
  min-height: 330px;
  padding: 24px 0 12px;
}
.mentor-panel-content {
  animation: mentor-panel-in 0.35s ease both;
}
.mentor-topic-controls {
  display: grid;
}
.mentor-topic-controls button {
  display: flex;
  align-items: center;
  gap: 14px;
  width: 100%;
  padding: 11px 10px;
  border: 0;
  border-bottom: 1px solid #36595415;
  background: transparent;
  text-align: left;
  font-size: 12px;
  font-weight: 700;
  transition: background 0.25s;
}
.mentor-topic-controls button > span:first-child {
  font-size: 9px;
  font-weight: 400;
  color: #738d80;
}
.mentor-topic-controls button[aria-pressed="true"] {
  background: #e7ebdf;
}
.mentor-topic-arrow {
  margin-left: auto;
  opacity: 0.2;
  transition:
    opacity 0.3s,
    transform 0.3s;
}
.mentor-topic-controls button[aria-pressed="true"] .mentor-topic-arrow {
  opacity: 1;
  transform: rotate(45deg);
}
.mentor-research-focus {
  display: grid;
  grid-template-columns: 42% 1fr;
  align-items: center;
  gap: 10px;
  min-height: 178px;
}
.mentor-research-mark {
  width: 100%;
  overflow: visible;
  color: #547c70;
}
.mentor-orbit {
  stroke: #839b874d;
  stroke-width: 1;
  transform-origin: center;
  transition: transform 0.85s cubic-bezier(0.22, 1, 0.36, 1);
}
.mentor-path {
  stroke: currentColor;
  stroke-width: 2;
  stroke-dasharray: 5 5;
  transition: stroke-dashoffset 0.85s;
}
.mentor-node {
  fill: #efd7a8;
  stroke: #738d80;
  stroke-width: 1.3;
  transform-box: fill-box;
  transform-origin: center;
  transition:
    transform 0.65s,
    fill 0.65s;
}
.mentor-node-ring {
  stroke: #a7b5a2;
  stroke-width: 1;
  stroke-dasharray: 3 6;
  transform-origin: 115px 80px;
  transition: transform 0.8s;
}
.topic-1 .orbit-one {
  transform: rotate(50deg);
}
.topic-1 .orbit-two {
  transform: rotate(-35deg);
}
.topic-1 .node-two {
  transform: scale(0.7);
  fill: #aec7bc;
}
.topic-1 .mentor-path {
  stroke-dashoffset: 25;
}
.topic-2 .orbit-one {
  transform: rotate(-40deg) scale(0.8);
}
.topic-2 .orbit-two {
  transform: rotate(60deg);
}
.topic-2 .node-one,
.topic-2 .node-three {
  transform: scale(1.5);
  fill: #dfb5a2;
}
.topic-2 .mentor-node-ring {
  transform: scale(1.4);
}
.mentor-topic-copy {
  animation: mentor-panel-in 0.35s both;
}
.mentor-topic-copy h4 {
  font-size: 16px;
  font-weight: 800;
  letter-spacing: -0.025em;
  line-height: 1.2;
  margin: 0 0 12px;
}
.mentor-topic-copy p {
  font-size: 11px;
  color: #74877b;
  line-height: 1.7;
}
.mentor-journey {
  list-style: none;
  margin: 0;
  padding: 0;
}
.mentor-journey li {
  display: grid;
  grid-template-columns: 65px 1fr;
  gap: 18px;
  padding: 16px 0;
  border-bottom: 1px solid #36595415;
}
.mentor-journey li > span {
  font-size: 12px;
  font-weight: 800;
  padding-top: 2px;
}
.mentor-journey h4 {
  font-size: 14px;
  font-weight: 800;
  letter-spacing: -0.02em;
  margin: 0 0 6px;
}
.mentor-journey p {
  color: #74877b;
  font-size: 11px;
  line-height: 1.7;
}
.mentor-work-caption {
  font-size: 10px;
  color: #74877b;
  margin-bottom: 12px !important;
}
.mentor-work > a {
  display: grid;
  grid-template-columns: 32px 1fr auto;
  gap: 13px;
  align-items: start;
  padding: 15px 0;
  border-bottom: 1px solid #36595420;
}
.mentor-paper-year {
  font-size: 10px;
  padding-top: 2px;
  color: #788c80;
}
.mentor-work small {
  display: block;
  font-size: 9px;
  line-height: 1.5;
  color: #788c80;
}
.mentor-work strong {
  display: block;
  font-size: 14px;
  line-height: 1.2;
  letter-spacing: -0.02em;
  margin: 5px 0;
}
.mentor-paper-full {
  display: block;
  font-size: 10px;
  line-height: 1.55;
  color: #74877b;
}
.mentor-doi {
  font-size: 9px;
  font-weight: 800;
  white-space: nowrap;
  padding-top: 18px;
  transition: transform 0.3s;
}
.mentor-work > a:hover .mentor-doi {
  transform: translate(3px, -3px);
}
.mentor-work > a:hover strong {
  text-decoration: underline;
  text-underline-offset: 3px;
}
.mentor-pi-links {
  display: flex;
  flex-wrap: wrap;
  gap: 18px;
  border-top: 1px solid #36595425;
  padding-top: 20px;
  margin-top: 8px;
}
.mentor-pi-links a {
  font-size: 8px;
  letter-spacing: 0.08em;
  font-weight: 800;
}
.mentor-passing {
  display: flex;
  justify-content: space-between;
  align-items: end;
  gap: 30px;
  margin: 90px 0 35px;
}
.mentor-passing h3 {
  font-size: clamp(30px, 3.5vw, 50px);
  font-weight: 900;
  letter-spacing: -0.05em;
  line-height: 1;
  margin-top: 14px;
}
.mentor-years {
  display: flex;
  align-items: center;
  gap: 22px;
  font-size: 16px;
  letter-spacing: -0.04em;
}
.mentor-years > span {
  opacity: 0.45;
}
.mentor-years svg {
  width: clamp(80px, 14vw, 200px);
  stroke: #829b8a;
  fill: none;
  stroke-width: 1;
}
.mentor-advisors {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 32px;
}
.mentor-advisors > article:nth-child(2) {
  margin-top: 45px;
}
.mentor-advisors > article:nth-child(3) {
  margin-top: 90px;
}
.mentor-advisor-photo {
  display: block;
  border: 0;
  padding: 10px;
  background: #f9f6ec;
  width: 100%;
  position: relative;
  box-shadow: 0 12px 36px #3659540d;
  transition:
    transform 0.45s cubic-bezier(0.22, 1, 0.36, 1),
    box-shadow 0.45s;
  text-align: left;
}
.mentor-advisor-photo .team-portrait {
  aspect-ratio: 4/5;
}
.mentor-advisor-photo:hover {
  transform: translateY(-8px) rotate(-1deg);
  box-shadow: 0 25px 40px #36595418;
}
.mentor-advisor-photo img {
  transition: transform 0.6s;
}
.mentor-advisor-photo:hover img {
  transform: scale(1.025);
}
.mentor-advisor-number {
  position: absolute;
  top: 22px;
  left: 22px;
  font-size: 9px;
  font-weight: 800;
  background: #f9f6ece6;
  padding: 8px 10px;
}
.mentor-advisor-open {
  position: absolute;
  right: 22px;
  bottom: 22px;
  background: #f9f6ecef;
  width: 36px;
  height: 36px;
  border-radius: 50%;
  display: grid;
  place-content: center;
}
.mentor-advisor-copy {
  padding: 24px 4px;
}
.mentor-advisor-copy > p {
  font-size: 9px;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  font-weight: 800;
}
.mentor-advisor-copy h4 {
  font-size: clamp(23px, 2.7vw, 39px);
  letter-spacing: -0.055em;
  font-weight: 800;
  margin: 8px 0 10px;
}
.mentor-advisor-copy > span {
  font-size: 10px;
  color: #7a8c80;
}
.mentor-credits {
  display: flex;
  justify-content: space-between;
  align-items: start;
  gap: 30px;
  padding-top: 35px;
  margin-top: 20px;
  border-top: 1px solid #36595425;
  font-size: 9px;
  color: #7b8f80;
  line-height: 1.7;
}
.mentor-credits p {
  max-width: 480px;
}
.mentor-credits a {
  color: #365954;
  font-weight: 800;
  white-space: nowrap;
}
.team-portrait.is-avatar {
  background: #f5d675;
}
.team-portrait.is-avatar img {
  object-fit: contain;
}
.team-profile-credential {
  font-size: 13px;
  font-weight: 700;
}
.team-profile-history {
  border-left: 2px solid #a4b79f;
  margin-top: 24px;
  padding-left: 18px;
  color: #72887a;
}
.team-profile-history small {
  display: block;
  font-size: 9px;
  letter-spacing: 0.1em;
  margin-bottom: 5px;
}
.team-profile-sources {
  margin-top: 28px;
  border-top: 1px solid #36595425;
  padding-top: 20px;
  display: flex;
  flex-wrap: wrap;
  gap: 16px;
}
.team-profile-sources a {
  color: #365954;
  font-size: 10px;
  text-decoration: underline;
  text-underline-offset: 5px;
}
.team-profile-credit {
  font-size: 9px !important;
  margin-top: 16px;
  color: #809084;
}
.team-profile-research {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 22px;
}
.team-profile-research span {
  border: 1px solid #36595425;
  padding: 8px 12px;
  border-radius: 22px;
  font-size: 10px;
}
.team-profile-milestones {
  margin-top: 28px;
}
.team-profile-milestones > div {
  display: grid;
  grid-template-columns: 60px 1fr;
  gap: 18px;
  margin: 18px 0;
}
.team-profile-milestones strong {
  font-size: 11px;
}
.team-profile-milestones p {
  font-size: 12px;
  margin: 0;
}
[data-mentor-visible="true"] {
  animation: mentor-reveal 0.9s cubic-bezier(0.22, 1, 0.36, 1) both;
}
@keyframes mentor-reveal {
  from {
    opacity: 0;
    transform: translateY(36px);
  }
  to {
    opacity: 1;
    transform: none;
  }
}
@keyframes mentor-panel-in {
  from {
    opacity: 0;
    transform: translateY(8px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
@media (max-width: 950px) {
  .mentor-heading {
    display: block;
  }
  .mentor-heading > p {
    margin-top: 25px;
    max-width: none;
  }
  .mentor-pi {
    grid-template-columns: 0.85fr 1fr;
  }
  .mentor-pi-photo {
    min-height: 730px;
  }
  .mentor-pi-main {
    padding: 28px 22px 22px;
  }
  .mentor-research-focus {
    grid-template-columns: 1fr;
  }
  .mentor-research-mark {
    width: 140px;
    height: 100px;
    margin: auto;
  }
  .mentor-topic-copy {
    padding: 5px 8px 20px;
  }
  .mentor-panel {
    min-height: 370px;
  }
  .mentor-advisors {
    gap: 18px;
  }
  .mentor-work > a {
    grid-template-columns: 1fr auto;
    gap: 10px;
  }
  .mentor-paper-year {
    display: none;
  }
}
@media (max-width: 600px) {
  .team-mentors {
    padding: 75px 6vw 45px;
  }
  .mentor-heading {
    margin-bottom: 35px;
  }
  .mentor-heading h2 {
    font-size: 10.5vw;
  }
  .mentor-heading > p {
    font-size: 12px;
  }
  .mentor-pi {
    display: block;
  }
  .mentor-pi-photo {
    min-height: 0;
    height: 440px;
    max-height: 70svh;
    width: 100%;
  }
  .mentor-pi-photo img {
    object-position: 50% 20% !important;
  }
  .mentor-pi-badge {
    left: 20px;
    top: 20px;
  }
  .mentor-photo-caption {
    padding: 20px;
  }
  .mentor-pi-main {
    padding: 30px 22px 24px;
  }
  .mentor-pi-intro h3 {
    font-size: 43px;
  }
  .mentor-pi-intro .team-eyebrow {
    font-size: 9px;
  }
  .mentor-tabs {
    gap: 22px;
    margin-top: 23px;
  }
  .mentor-tabs button {
    font-size: 10px;
  }
  .mentor-panel {
    min-height: 400px;
  }
  .mentor-research-mark {
    width: 170px;
    height: 120px;
  }
  .mentor-journey li {
    grid-template-columns: 56px 1fr;
    gap: 12px;
    padding: 18px 0;
  }
  .mentor-journey h4 {
    font-size: 13px;
  }
  .mentor-passing {
    display: block;
    margin-top: 65px;
  }
  .mentor-years {
    margin-top: 30px;
  }
  .mentor-years svg {
    flex: 1;
    max-width: 200px;
  }
  .mentor-advisors {
    grid-template-columns: 1fr;
    gap: 28px;
  }
  .mentor-advisors > article:nth-child(n) {
    margin-top: 0;
  }
  .mentor-advisors > article {
    display: grid;
    grid-template-columns: 48% 1fr;
    gap: 18px;
    align-items: center;
  }
  .mentor-advisor-photo {
    padding: 6px;
  }
  .mentor-advisor-copy {
    padding: 12px 0;
  }
  .mentor-advisor-copy h4 {
    font-size: 27px;
  }
  .mentor-advisor-copy > p {
    font-size: 8px;
  }
  .mentor-advisor-copy > span {
    font-size: 9px;
    line-height: 1.6;
    display: block;
  }
  .mentor-advisor-number {
    top: 14px;
    left: 14px;
    padding: 4px 6px;
    font-size: 8px;
  }
  .mentor-advisor-open {
    right: 12px;
    bottom: 12px;
    width: 28px;
    height: 28px;
  }
  .mentor-credits {
    display: block;
  }
  .mentor-credits a {
    display: inline-block;
    margin-top: 18px;
  }
}
@media (prefers-reduced-motion: reduce) {
  .team-mentors *,
  .team-mentors *:after {
    animation: none !important;
    transition: none !important;
  }
  .mentor-advisor-photo:hover,
  .mentor-pi-photo:hover img,
  .mentor-advisor-photo:hover img {
    transform: none;
  }
}

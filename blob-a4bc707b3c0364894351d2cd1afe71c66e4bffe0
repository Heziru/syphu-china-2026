.project-evidence {
  color: #3d5d55;
  font-family: Arial, sans-serif;
  max-width: 1120px;
  margin: 0 auto;
}
.project-evidence__nav {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 5px;
  padding: 6px;
  margin: 0 0 65px;
  width: fit-content;
  max-width: 100%;
  border: 1px solid #dae0ce;
  border-radius: 30px;
  background: #faf9f0d9;
}
.project-evidence__nav a {
  padding: 10px 18px;
  border-radius: 22px;
  font-size: 12px;
  font-weight: 800;
  color: #5c796a;
  text-decoration: none;
}
.project-evidence__nav a[aria-current="page"] {
  background: #dce5d4;
  color: #355c4f;
}
.project-evidence__nav a:hover {
  background: #e8edde;
}
.project-evidence__section {
  display: grid;
  grid-template-columns: minmax(180px, 0.72fr) minmax(0, 1.3fr);
  gap: clamp(30px, 7vw, 90px);
  padding: 56px 0 62px;
  border-top: 1px solid #dce1d0;
}
.project-evidence__section-heading > span,
.project-evidence__eyebrow {
  display: block;
  color: #819485;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.16em;
  text-transform: uppercase;
  margin-bottom: 16px;
}
.project-evidence .project-evidence__section h2 {
  margin: 0;
  font-size: clamp(27px, 3.1vw, 42px);
  line-height: 1.04;
  text-wrap: balance;
}
.project-evidence .project-evidence__section-body p {
  font-size: 15px;
  line-height: 1.85;
  margin: 0 0 22px;
}
.project-evidence .project-evidence__section-body h3 {
  font:
    800 20px/1.25 Arial,
    sans-serif;
  letter-spacing: -0.03em;
  margin: 0 0 13px;
}
.project-evidence__cite {
  font-size: 10px;
  margin-left: 4px;
  vertical-align: super;
  text-decoration: none;
  color: #3c7961;
}
.project-evidence__next {
  display: inline-block;
  font-size: 12px;
  line-height: 1.5;
  font-weight: 800;
  color: #507562;
  margin: 6px 24px 8px 0;
  text-decoration: none;
  border-bottom: 1px solid #9eb5a0;
  padding-bottom: 6px;
}
.project-evidence__next span {
  padding-left: 10px;
}
.project-evidence__pair {
  display: grid;
  gap: 24px;
}
.project-evidence__mechanism {
  margin: 28px 0 36px;
}
.project-evidence__chain {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 7px;
}
.project-evidence__chain > div {
  position: relative;
  min-width: 0;
  padding: 17px 12px;
  background: #e5ecdc;
  border: 1px solid #cfdcc4;
  border-radius: 12px;
}
.project-evidence__chain > div:not(:last-child)::after {
  content: "→";
  position: absolute;
  right: -10px;
  top: 39%;
  z-index: 1;
  color: #52715e;
  font-size: 15px;
}
.project-evidence__chain small {
  display: block;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  font-size: 8px;
  color: #83987e;
  margin-bottom: 12px;
}
.project-evidence__chain strong {
  display: block;
  font-size: clamp(12px, 1.3vw, 17px);
  letter-spacing: -0.03em;
  margin-bottom: 8px;
}
.project-evidence__chain span {
  display: block;
  font-size: 9px;
  line-height: 1.5;
  color: #778b71;
}
.project-evidence figcaption {
  font-size: 10px;
  color: #85957e;
  margin-top: 12px;
  line-height: 1.6;
}
.project-evidence__sequence {
  list-style: none;
  padding: 0;
  margin: 28px 0;
  counter-reset: evidence-step;
}
.project-evidence__sequence li {
  position: relative;
  counter-increment: evidence-step;
  padding: 0 0 26px 37px;
  border-left: 1px solid #c5d7bb;
}
.project-evidence__sequence li:last-child {
  padding-bottom: 0;
}
.project-evidence__sequence li::before {
  content: counter(evidence-step, decimal-leading-zero);
  position: absolute;
  left: -12px;
  top: 0;
  background: #f4f2e8;
  color: #819775;
  font-size: 10px;
  font-weight: 800;
  padding: 5px 3px;
}
.project-evidence__sequence strong {
  display: block;
  font-size: 18px;
  margin-bottom: 4px;
}
.project-evidence__sequence span {
  display: block;
  font-size: 13px;
  line-height: 1.8;
}
.project-evidence__readouts {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 30px 26px;
}
.project-evidence__readouts article {
  min-width: 0;
}
.project-evidence .project-evidence__readouts p {
  font-size: 13px;
  line-height: 1.75;
}
.project-evidence__dot {
  display: block;
  width: 18px;
  height: 18px;
  border: 3px solid #e1ebd6;
  outline: 1px solid #a9bba0;
  border-radius: 50%;
  background: #789584;
  margin-bottom: 18px;
}
.project-evidence__dot--rose {
  background: #bc928a;
  outline-color: #ceb7a5;
}
.project-evidence__dot--sage {
  background: #a1b88c;
}
.project-evidence__dot--gold {
  background: #cfb882;
  outline-color: #d5c4a0;
}
.project-evidence__detail {
  margin: 20px 0;
  border-top: 1px solid #cedbc4;
}
.project-evidence__detail summary {
  padding: 18px 24px 18px 0;
  font-size: 14px;
  font-weight: 800;
  cursor: pointer;
  color: #53755e;
}
.project-evidence .project-evidence__detail p {
  font-size: 13px;
  line-height: 1.85;
}
.project-evidence__variables {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14px;
  margin: 25px 0;
}
.project-evidence__variables > div {
  padding: 13px 0;
  border-bottom: 1px solid #ccd9c4;
}
.project-evidence__variables strong {
  font-size: 30px;
  font-weight: 900;
  color: #99ae90;
}
.project-evidence__variables span {
  display: block;
  font-size: 10px;
  line-height: 1.6;
  margin-top: 5px;
}
.project-evidence__scenario {
  border: 1px solid #d2dfc8;
  background: #eff2e7;
  padding: 22px;
  border-radius: 18px;
  margin-bottom: 20px;
}
.project-evidence__scenario-tabs {
  display: flex;
  gap: 5px;
  flex-wrap: wrap;
  margin-bottom: 30px;
}
.project-evidence__scenario-tabs button {
  border: 1px solid #ccd9c3;
  background: transparent;
  padding: 8px 10px;
  border-radius: 17px;
  color: #698161;
  font:
    700 10px/1.3 Arial,
    sans-serif;
}
.project-evidence__scenario-tabs button[aria-selected="true"] {
  background: #d5e3c8;
  color: #3c644b;
}
.project-evidence__scenario-body {
  display: grid;
  grid-template-columns: 56px 1fr;
  gap: 20px;
}
.project-evidence .project-evidence__scenario-body p {
  font-size: 13px;
}
.project-evidence__state-mark {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 9px;
  padding-top: 5px;
}
.project-evidence__state-mark i {
  display: block;
  height: 8px;
  width: 27px;
  border-radius: 5px;
  background: #8eaa7f;
}
.project-evidence__state-mark[data-state="pulse"] i:nth-child(3) {
  opacity: 0.22;
}
.project-evidence__state-mark[data-state="withdrawn"] i:nth-child(n + 3) {
  opacity: 0.15;
}
.project-evidence__scenario > small {
  display: block;
  font-size: 9px;
  color: #84977a;
}
.project-evidence__status-grid {
  display: grid;
  gap: 14px;
  margin: 28px 0 0;
}
.project-evidence__status-grid article {
  background: #f9f8ef;
  padding: 22px;
  border: 1px solid #dbe2d0;
  border-radius: 15px;
}
.project-evidence__status-grid article > span {
  display: inline-block;
  font-size: 9px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: #93a387;
  margin-bottom: 12px;
}
.project-evidence .project-evidence__status-grid p {
  font-size: 13px;
  margin: 0;
}
.project-evidence__claim {
  padding: 0 0 24px;
  margin-bottom: 26px;
  border-bottom: 1px solid #d9e1ce;
}
.project-evidence .project-evidence__claim p {
  font-size: 13px;
  margin-bottom: 12px;
}
.project-evidence__references {
  border-top: 1px solid #cbd8c1;
  margin-top: 35px;
  padding: 45px 0;
}
.project-evidence__references > p {
  max-width: 760px;
  font-size: 12px;
  color: #81917b;
}
.project-evidence__references ol {
  list-style: none;
  padding: 0;
  margin: 30px 0 0;
}
.project-evidence__references li {
  display: flex;
  gap: 18px;
  padding: 18px 0;
  border-bottom: 1px solid #e0e5d7;
}
.project-evidence__references li > span {
  color: #9aaa8f;
  font-size: 11px;
  min-width: 30px;
}
.project-evidence__references strong {
  display: block;
  font-size: 12px;
  line-height: 1.7;
  font-weight: 700;
}
.project-evidence__references small {
  display: block;
  font-size: 11px;
  color: #85947b;
}
.project-evidence__references a {
  font-size: 10px;
  font-weight: 800;
  color: #567b5c;
}
.project-evidence__end {
  display: flex;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 20px;
  border-top: 1px solid #cbd8c1;
  padding-top: 30px;
}
.project-evidence__end a {
  font-size: 12px;
  font-weight: 800;
  color: #527455;
  text-decoration: none;
}
@media (max-width: 800px) {
  .project-evidence__section {
    grid-template-columns: 1fr;
    gap: 26px;
    padding: 40px 0;
  }
  .project-evidence__section-heading {
    max-width: 520px;
  }
  .project-evidence__nav {
    margin-bottom: 36px;
  }
  .project-evidence__nav a {
    padding: 9px 13px;
    font-size: 11px;
  }
}
@media (max-width: 440px) {
  .project-evidence__nav a {
    padding: 9px 10px;
    font-size: 10px;
  }
  .project-evidence__readouts {
    grid-template-columns: 1fr;
    gap: 8px;
  }
  .project-evidence__chain {
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }
  .project-evidence__chain > div:nth-child(2)::after {
    content: none;
  }
  .project-evidence__chain strong {
    font-size: 16px;
  }
  .project-evidence__scenario {
    padding: 16px;
  }
  .project-evidence__scenario-body {
    grid-template-columns: 27px 1fr;
    gap: 14px;
  }
}

/* Nocturne particle opening — black void, Lorenz + Möbius (three.js) */

.nocturne-particle {
  position: relative;
  min-height: calc(100vh - 56px);
  min-height: calc(100dvh - 56px);
  background: #000;
  overflow: hidden;
  cursor: default;
}

.nocturne-particle__canvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;
}

.nocturne-particle__overlay {
  position: absolute;
  inset: 0;
  pointer-events: none;
  background:
    radial-gradient(ellipse 80% 65% at 50% 42%, transparent 30%, rgba(0, 0, 0, 0.55) 100%),
    linear-gradient(180deg, rgba(0, 0, 0, 0.5) 0%, transparent 22%, transparent 78%, rgba(0, 0, 0, 0.85) 100%);
}

.nocturne-particle__brand {
  position: absolute;
  top: clamp(1rem, 3vh, 1.75rem);
  left: clamp(1rem, 4vw, 2.5rem);
  z-index: 2;
  display: flex;
  align-items: center;
  gap: 0.55rem;
  pointer-events: none;
}

.nocturne-particle__logo-mark {
  font-size: 1.1rem;
  color: rgba(245, 240, 230, 0.85);
  filter: drop-shadow(0 0 8px rgba(232, 184, 74, 0.45));
}

.nocturne-particle__logo-text {
  font-size: 0.72rem;
  letter-spacing: 0.28em;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.72);
}

.nocturne-particle__aside {
  position: absolute;
  left: clamp(1rem, 4vw, 2.5rem);
  top: 50%;
  z-index: 2;
  transform: translateY(-50%);
  margin: 0;
  max-width: 8ch;
  font-size: 0.62rem;
  line-height: 1.55;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.38);
  pointer-events: none;
}

.nocturne-particle__footer {
  position: absolute;
  left: 50%;
  bottom: clamp(1.25rem, 4vh, 2.5rem);
  z-index: 2;
  transform: translateX(-50%);
  width: min(92vw, 640px);
  text-align: center;
  pointer-events: none;
}

.nocturne-particle__quote {
  margin: 0;
  font-size: clamp(0.82rem, 2vw, 0.95rem);
  letter-spacing: 0.12em;
  color: rgba(255, 255, 255, 0.55);
}

.nocturne-particle__sub {
  margin: 0.45rem 0 0;
  font-size: clamp(0.95rem, 2.2vw, 1.1rem);
  letter-spacing: 0.2em;
  color: rgba(232, 184, 74, 0.82);
}

.nocturne-particle__loader {
  margin: 1rem auto 0;
  width: 36px;
  height: 36px;
}

.nocturne-particle__loader-svg {
  width: 100%;
  height: 100%;
  transform: rotate(-90deg);
}

.nocturne-particle__loader-track {
  fill: none;
  stroke: rgba(255, 255, 255, 0.12);
  stroke-width: 1.2;
}

.nocturne-particle__loader-arc {
  fill: none;
  stroke: rgba(255, 255, 255, 0.65);
  stroke-width: 1.2;
  stroke-dasharray: 100;
  stroke-linecap: round;
  transition: stroke-dashoffset 0.15s linear;
}

.nocturne-particle__enter {
  pointer-events: auto;
  margin-top: 0.85rem;
  padding: 0.45rem 1.2rem;
  border: 1px solid rgba(255, 255, 255, 0.28);
  border-radius: 999px;
  background: transparent;
  color: rgba(255, 255, 255, 0.75);
  font-size: 0.68rem;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  cursor: pointer;
  transition:
    border-color 0.25s ease,
    color 0.25s ease;
}

.nocturne-particle__enter:hover {
  border-color: rgba(232, 184, 74, 0.75);
  color: rgba(232, 184, 74, 0.95);
}

@media (max-width: 768px) {
  .nocturne-particle__aside {
    display: none;
  }
}

@media (prefers-reduced-motion: reduce) {
  .nocturne-particle__loader-arc {
    transition: none;
    stroke-dashoffset: 0;
  }
}

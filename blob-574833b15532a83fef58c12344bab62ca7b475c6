/* 时光碎片开屏 — 纯黑粒子场，末尾标题飞出 */

.nocturne-particle {
  position: relative;
  min-height: calc(100vh - 56px);
  min-height: calc(100dvh - 56px);
  background: #000;
  overflow: hidden;
  cursor: none;
}

.nocturne-particle--ready {
  cursor: pointer;
}

.nocturne-particle__canvas {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  display: block;
  cursor: none;
}

.nocturne-particle__title {
  position: absolute;
  inset: 0;
  z-index: 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: clamp(0.65rem, 2vh, 1rem);
  pointer-events: none;
  text-align: center;
  padding: 0 1.5rem;
}

.nocturne-particle__title-en {
  margin: 0;
  font-size: clamp(1.65rem, 5.5vw, 3.2rem);
  font-weight: 300;
  letter-spacing: 0.38em;
  text-indent: 0.38em;
  text-transform: uppercase;
  color: rgba(255, 255, 255, 0.92);
  opacity: 0;
  transform: translate3d(-18vw, 12px, 0) scale(0.94);
  filter: blur(6px);
  animation: nocturne-title-en 1.65s cubic-bezier(0.22, 1, 0.36, 1) forwards;
}

.nocturne-particle__title-zh {
  margin: 0;
  font-size: clamp(1rem, 2.8vw, 1.35rem);
  letter-spacing: 0.42em;
  text-indent: 0.42em;
  color: rgba(232, 184, 74, 0.88);
  opacity: 0;
  transform: translate3d(16vw, 18px, 0) scale(0.96);
  filter: blur(5px);
  animation: nocturne-title-zh 1.85s cubic-bezier(0.22, 1, 0.36, 1) 0.22s forwards;
}

@keyframes nocturne-title-en {
  to {
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1);
    filter: blur(0);
  }
}

@keyframes nocturne-title-zh {
  to {
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1);
    filter: blur(0);
  }
}

@media (prefers-reduced-motion: reduce) {
  .nocturne-particle {
    cursor: pointer;
  }

  .nocturne-particle__canvas {
    cursor: pointer;
  }

  .nocturne-particle__title-en,
  .nocturne-particle__title-zh {
    animation: none;
    opacity: 1;
    transform: none;
    filter: none;
  }
}
